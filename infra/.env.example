# MedLink — Infrastructure environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# PostgreSQL
POSTGRES_DB=medlink
POSTGRES_USER=medlink_user
POSTGRES_PASSWORD=change_me_in_production

# API database connection string
DATABASE_URL=postgresql://medlink_user:change_me_in_production@localhost:5432/medlink

# Firebase — use service account JSON for production (paste the entire JSON as one line)
# For local dev with Application Default Credentials, set FIREBASE_PROJECT_ID only.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=

# CORS — comma-separated list of allowed origins for the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Logging — valid values: trace, debug, info, warn, error
LOG_LEVEL=info
