# MedLink API — local environment variables
# Copy to .env — never commit real values.

PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://medlink_user:change_me_in_production@localhost:5432/medlink
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
LOG_LEVEL=info

TURN_URL=turn:turn.example.com:3478
TURN_USERNAME=medlink
TURN_PASSWORD=some-secure-password
