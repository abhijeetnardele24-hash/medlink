# MedLink API — local environment variables
# Copy to .env — never commit real values.

PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://medlink_user:change_me_in_production@localhost:5432/medlink
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
LOG_LEVEL=info

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Scalability & External Integrations
REDIS_URL=redis://localhost:6379
DB_MAX_CONNECTIONS=50
RESEND_API_KEY=re_your_resend_api_key_here
PATIENT_PORTAL_URL=http://localhost:5176
