{
  "name": "medlink-api",
  "version": "1.0.0",
  "description": "MedLink backend API service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npx tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "npx tsx tests/run-all-tests.ts",
    "test:e2e": "npx tsx tests/e2e-full-ecosystem.ts",
    "test": "npx tsx tests/run-all-tests.ts && npx tsx tests/e2e-full-ecosystem.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.5.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.0",
    "pino": "^9.6.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.4",
    "resend": "^6.19.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
