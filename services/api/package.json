    "@types/multer": "^1.4.12",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.3",
    "@types/socket.io": "^3.0.1",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.30.5",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.3",
